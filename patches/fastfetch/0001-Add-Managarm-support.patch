+static size_t c16rtomb(char* __s, char16_t __c16, mbstate_t* __ps) {
+    (void) __ps;
+    static char32_t pending_high = 0;
+    char32_t c;
+    if (pending_high) {
+        if (__c16 >= 0xDC00 && __c16 <= 0xDFFF)
+            c = 0x10000 + ((pending_high - 0xD800) << 10) + (__c16 - 0xDC00);
+        else { pending_high = 0; return (size_t) -1; }
+        pending_high = 0;
+    } else if (__c16 >= 0xD800 && __c16 <= 0xDBFF) {
+        pending_high = __c16;
+        return 0;
+    } else if (__c16 >= 0xDC00 && __c16 <= 0xDFFF) {
+        return (size_t) -1;
+    } else {
+        c = __c16;
+    }
+    if (c < 0x80) { __s[0] = (char) c; return 1; }
+    if (c < 0x800) {
+        __s[0] = (char) (0xC0 | (c >> 6));
+        __s[1] = (char) (0x80 | (c & 0x3F));
+        return 2;
+    }
+    if (c < 0x10000) {
+        __s[0] = (char) (0xE0 | (c >> 12));
+        __s[1] = (char) (0x80 | ((c >> 6) & 0x3F));
+        __s[2] = (char) (0x80 | (c & 0x3F));
+        return 3;
+    }
+    __s[0] = (char) (0xF0 | (c >> 18));
+    __s[1] = (char) (0x80 | ((c >> 12) & 0x3F));
+    __s[2] = (char) (0x80 | ((c >> 6) & 0x3F));
+    __s[3] = (char) (0x80 | (c & 0x3F));
+   return 4;
+}
